# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Spike / Demo (exploratory + demo apps); the .xcodeproj is regenerated by xcodegen from project.yml
Spike/build/
Spike/*.xcodeproj/
Demo/build/
Demo/*.xcodeproj/

# macOS
.DS_Store

# Local-only artifacts (design mockups, archives, stray logs) — not part of the repo
ReferenceDesign/
Archive.zip
*.log

# Phase-4 host app (task PH4); the .xcodeproj is regenerated by xcodegen from Host/project.yml
# Derived data for the Host project, whatever -derivedDataPath a run picks
# (Host/build is the default; Host/build-26 is the iOS 26.5 control's).
Host/build*/
Host/*.xcodeproj/
Host/Engine/*-Info.plist
