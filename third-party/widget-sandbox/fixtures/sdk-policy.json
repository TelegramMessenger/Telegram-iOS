  "hapticGate": [
    {
      "name": "a burst of 5, then one every 100 ms",
      "steps": [
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 0, "visible": true, "expect": "report" },
        { "at": 50, "visible": true, "expect": "drop" },
        { "at": 100, "visible": true, "expect": "play" },
        { "at": 150, "visible": true, "expect": "drop" },
        { "at": 199, "visible": true, "expect": "drop" },
        { "at": 300, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "play" },
        { "at": 999, "visible": true, "expect": "drop" },
        { "at": 1000, "visible": true, "expect": "report" }
      ]
    },
    {
      "name": "the bucket refills to 5, not beyond",
      "steps": [
        { "at": 0, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "play" },
        { "at": 10000, "visible": true, "expect": "report" }
      ]
    },
    {
      "name": "hidden: dropped without using the bucket, reported once per second",
      "steps": [
        { "at": 0, "visible": false, "expect": "report" },
        { "at": 10, "visible": false, "expect": "drop" },
        { "at": 20, "visible": true, "expect": "play" },
        { "at": 20, "visible": true, "expect": "play" },
        { "at": 20, "visible": true, "expect": "play" },
        { "at": 20, "visible": true, "expect": "play" },
        { "at": 20, "visible": true, "expect": "play" },
        { "at": 20, "visible": true, "expect": "drop" },
        { "at": 1500, "visible": false, "expect": "report" }
      ]
    },
    {
      "name": "a clock that goes back refills nothing",
      "steps": [
        { "at": 1000, "visible": true, "expect": "play" },
        { "at": 1000, "visible": true, "expect": "play" },
        { "at": 1000, "visible": true, "expect": "play" },
        { "at": 1000, "visible": true, "expect": "play" },
        { "at": 1000, "visible": true, "expect": "play" },
        { "at": 500, "visible": true, "expect": "report" },
        { "at": 600, "visible": true, "expect": "play" }
      ]
    }
  ],
